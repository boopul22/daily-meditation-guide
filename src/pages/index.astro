---
import MainLayout from '../layouts/MainLayout.astro';
import HomeContent from '../components/HomeContent';
import BreathPacer from '../components/tools/BreathPacer';
import { rowToSession, SESSION_SELECT_WITH_AUTHOR } from '../lib/db';
import { featuredTools } from '../lib/tools/catalog';
import type { Session } from '../types';

const db = Astro.locals.runtime.env.DB;
const [sessionsRes, videosRes] = await Promise.all([
  db.prepare(
    `${SESSION_SELECT_WITH_AUTHOR} WHERE s.status = 'published' ORDER BY s.published_at DESC`
  ).all(),
  db.prepare(
    "SELECT video_id, title, slug FROM youtube_videos WHERE slug != '' ORDER BY published_at DESC LIMIT 12"
  ).all(),
]);

const sessions: Session[] = ((sessionsRes.results || []) as any[]).map((row) => rowToSession(row));
const slimSessions = sessions.map(({ fullContent, faqItems, relatedSessions, ...rest }) => rest);
const videos = ((videosRes.results || []) as any[]).map((r) => ({
  id: r.video_id as string,
  title: r.title as string,
  slug: r.slug as string,
}));
const tools = featuredTools();

Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600, stale-while-revalidate=86400');

const websiteJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Daily Meditation Guide",
  "description": "Free mindfulness tools and guided meditation sessions for sleep, anxiety, and focus.",
  "url": "https://dailymeditationguide.com",
  "inLanguage": "en",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://dailymeditationguide.com/tools"
    },
    "query-input": "required name=search_term_string"
  }
});

const extraHead = `<script type="application/ld+json">${websiteJsonLd}</script>`;
---

<MainLayout
  title="Daily Meditation Guide"
  description="Free breathing timers, grounding tools, and guided meditation sessions. No signup — start in seconds."
  canonical="https://dailymeditationguide.com/"
  extraHead={extraHead}
>
  <div class="space-y-20 transition-all duration-500 ease-in-out animate-[fade-enter_0.5s_ease-out]">

    <section class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14 items-center">
      <div class="space-y-7">
        <p class="font-display text-indigo-400/90 text-sm tracking-wide">Daily Meditation Guide</p>
        <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-medium text-zinc-100 tracking-tight leading-[1.1]">
          Free breathing and grounding tools
        </h1>
        <p class="text-lg text-zinc-500 font-light max-w-md leading-relaxed">
          No signup. Start in seconds. Guided sessions when you want more.
        </p>
        <div class="flex flex-col sm:flex-row items-center gap-3 pt-1 w-full sm:w-auto">
          <a href="/tools/box-breathing-timer" class="flex items-center justify-center px-6 py-3 bg-zinc-100 hover:bg-white text-zinc-950 rounded-full font-medium text-sm transition-all w-full sm:w-auto">
            Start box breathing
          </a>
          <a href="/tools" class="px-6 py-3 border border-white/10 hover:border-white/20 hover:bg-white/5 rounded-full text-zinc-300 text-sm font-medium transition-all w-full sm:w-auto text-center">
            Browse all tools
          </a>
        </div>
      </div>

      <div class="rounded-3xl border border-white/[0.06] bg-zinc-900/40 p-4 sm:p-6">
        <BreathPacer client:load initialPattern="box" compact showPatternSwitcher={false} />
      </div>
    </section>

    <section class="space-y-6">
      <div class="flex items-end justify-between gap-4">
        <h2 class="font-display text-2xl text-zinc-100 font-medium tracking-tight">Popular free tools</h2>
        <a href="/tools" class="text-xs text-indigo-400 hover:text-indigo-300 font-medium">View all →</a>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {tools.map((tool) => (
          <a
            href={tool.href}
            class="group rounded-3xl border border-white/[0.06] bg-zinc-900/30 p-5 hover:border-white/15 transition-colors space-y-2"
          >
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full" style={`background:${tool.accent}`}></span>
              <iconify-icon icon={tool.icon} width="16" class="text-zinc-400"></iconify-icon>
            </div>
            <h3 class="font-display text-lg text-zinc-100 group-hover:text-white">{tool.shortTitle}</h3>
            <p class="text-sm text-zinc-500 line-clamp-2">{tool.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="rounded-3xl border border-white/[0.06] bg-gradient-to-br from-zinc-900/50 to-zinc-950/80 p-6 sm:p-8 grid md:grid-cols-3 gap-6">
      <div class="space-y-2">
        <h2 class="font-display text-lg text-zinc-100">How it works</h2>
        <p class="text-sm text-zinc-500 leading-relaxed">Open a tool, breathe or ground for a few minutes, then continue with a guided track if you want a voice beside you.</p>
      </div>
      <div class="space-y-2">
        <h3 class="text-sm font-medium text-zinc-200">Private by default</h3>
        <p class="text-sm text-zinc-500 leading-relaxed">No account required for tools. Preferences stay in your browser.</p>
      </div>
      <div class="space-y-2">
        <h3 class="text-sm font-medium text-zinc-200">Need guidance?</h3>
        <p class="text-sm text-zinc-500 leading-relaxed">
          Take the <a href="/tools/breathing-technique-quiz" class="text-indigo-400 hover:text-indigo-300">breathing quiz</a> or browse <a href="/sessions" class="text-indigo-400 hover:text-indigo-300">sessions</a>.
        </p>
      </div>
    </section>

    <section class="max-w-4xl mx-auto space-y-6">
      <h2 class="font-display text-2xl md:text-3xl font-medium text-zinc-100 tracking-tight text-center">
        Tools first. Sessions when you want more.
      </h2>
      <div class="grid md:grid-cols-2 gap-8 text-zinc-400 text-sm leading-relaxed">
        <p>
          Daily Meditation Guide is a free mindfulness toolkit — box breathing, 4-7-8, physiological sigh, grounding, and more — plus a curated library of guided audio and video sessions for sleep, anxiety, and focus.
        </p>
        <p>
          Start with a two-minute pacer when you need relief now. When you want a teacher’s voice, open a session from our library. No subscription required to begin.
        </p>
      </div>
    </section>

    <HomeContent client:visible sessions={slimSessions} videos={videos} />
  </div>
</MainLayout>
