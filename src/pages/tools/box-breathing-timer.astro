---
import ToolLayout from '../../components/tools/ToolLayout.astro';
import BreathPacer from '../../components/tools/BreathPacer';
import RelatedSessions from '../../components/tools/RelatedSessions.astro';
import ToolEmailCapture from '../../components/tools/ToolEmailCapture';
import ToolRichContent from '../../components/tools/ToolRichContent.astro';
import { TOOLS } from '../../lib/tools/catalog';
import { LANDING } from '../../lib/tools/landingCopy';

const copy = LANDING['box-breathing-timer'];
const siblings = TOOLS.filter((t) => t.patternId && t.patternId !== 'box').slice(0, 4).map((t) => ({
  href: t.href,
  label: t.shortTitle,
}));

Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600, stale-while-revalidate=86400');
---

<ToolLayout
  title="Box Breathing Timer — Free Online (4-4-4-4)"
  description="Free box breathing timer with visual and audio cues. Equal 4-4-4-4 rhythm for focus and stress. No signup. Private in your browser."
  canonical="https://dailymeditationguide.com/tools/box-breathing-timer"
  h1="Box Breathing Timer"
  lead={copy.lead}
  howToSteps={copy.howToSteps}
  faq={copy.faq}
  relatedCategoryHref="/category/breathwork"
  relatedCategoryLabel="Breathwork sessions"
  siblingLinks={siblings}
>
  <BreathPacer client:load slot="tool" initialPattern="box" />
  <div slot="after-tool" class="space-y-6 mt-6">
    <RelatedSessions categoryHints={['breathwork', 'focus', 'anxiety']} />
    <ToolEmailCapture client:visible toolSlug="box-breathing-timer" />
  </div>
  <ToolRichContent slot="content" sections={copy.sections} />
</ToolLayout>
