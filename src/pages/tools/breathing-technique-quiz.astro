---
import ToolLayout from '../../components/tools/ToolLayout.astro';
import BreathingQuiz from '../../components/tools/BreathingQuiz';
import ToolRichContent from '../../components/tools/ToolRichContent.astro';
import { TOOLS } from '../../lib/tools/catalog';
import { LANDING } from '../../lib/tools/landingCopy';

const copy = LANDING['breathing-technique-quiz'];
const siblings = TOOLS.filter((t) => t.patternId).slice(0, 4).map((t) => ({
  href: t.href,
  label: t.shortTitle,
}));

Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600, stale-while-revalidate=86400');
---

<ToolLayout
  title="Which Breathing Technique? Free Quiz"
  description="30-second quiz to find the right breathing technique for sleep, anxiety, or focus, then open a free timer. No signup."
  canonical="https://dailymeditationguide.com/tools/breathing-technique-quiz"
  h1="Which breathing technique should you use?"
  lead={copy.lead}
  howToSteps={copy.howToSteps}
  faq={copy.faq}
  siblingLinks={siblings}
>
  <BreathingQuiz client:load slot="tool" />
  <ToolRichContent slot="content" sections={copy.sections} />
</ToolLayout>
