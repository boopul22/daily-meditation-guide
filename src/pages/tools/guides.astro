---
/**
 * Supporting guide index for tool keywords.
 * Each tool page carries deep how-to + FAQ; this hub links them for internal SEO.
 */
import MainLayout from '../../layouts/MainLayout.astro';
import { TOOLS } from '../../lib/tools/catalog';

Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600, stale-while-revalidate=86400');
---

<MainLayout
  title="Mindfulness Tool Guides — How to Use Free Breath & Grounding Tools"
  description="How-to guides for free breathing timers, grounding exercises, cognitive shuffle, PMR, and other mindfulness tools on Daily Meditation Guide."
  canonical="https://dailymeditationguide.com/tools/guides"
>
  <div class="max-w-3xl mx-auto space-y-8 animate-[fade-enter_0.4s_ease-out]">
    <header class="space-y-3">
      <p class="text-xs uppercase tracking-widest text-indigo-400">Guides</p>
      <h1 class="font-display text-4xl text-zinc-100 font-medium tracking-tight">Tool guides</h1>
      <p class="text-zinc-500 leading-relaxed">
        Each free tool page includes practice steps, when-to-use notes, and FAQ. Use this list to jump straight into the interactive version.
      </p>
    </header>

    <div class="prose prose-invert max-w-none">
      <p>
        Start with the technique that matches the moment. Fast stress: physiological sigh. Focus: box or coherent breathing.
        Sleep: 4-7-8, PMR, or cognitive shuffle. Overwhelm: 5-4-3-2-1 grounding. If you only want a guided voice, skip to the
        <a href="/tools/session-finder">session finder</a>.
      </p>
    </div>

    <ul class="space-y-3">
      {TOOLS.map((t) => (
        <li>
          <a href={t.href} class="block rounded-2xl border border-white/[0.06] bg-zinc-900/30 px-4 py-3 hover:border-white/15 transition-colors">
            <span class="text-sm text-zinc-100 font-medium">{t.title}</span>
            <span class="block text-xs text-zinc-500 mt-1">{t.description}</span>
          </a>
        </li>
      ))}
    </ul>

    <section class="prose prose-invert max-w-none">
      <h2>How these guides are structured</h2>
      <p>
        Every tool page puts the interactive practice first. Below that you get how-to steps, longer explainers (what it is, when it helps, common mistakes), and FAQ markup for search. No thin stub pages.
      </p>
      <p>
        Prefer browsing by goal? Open the
        <a href="/tools">tools hub</a>
        and filter by anxiety, sleep, or focus.
      </p>
    </section>

    <a href="/tools" class="inline-flex text-sm text-indigo-400 hover:text-indigo-300">← Back to all tools</a>
  </div>
</MainLayout>
