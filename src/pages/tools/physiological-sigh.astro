---
import ToolLayout from '../../components/tools/ToolLayout.astro';
import BreathPacer from '../../components/tools/BreathPacer';
import RelatedSessions from '../../components/tools/RelatedSessions.astro';
import ToolEmailCapture from '../../components/tools/ToolEmailCapture';
import ToolRichContent from '../../components/tools/ToolRichContent.astro';
import { TOOLS } from '../../lib/tools/catalog';
import { LANDING } from '../../lib/tools/landingCopy';

const copy = LANDING['physiological-sigh'];
const siblings = TOOLS.filter((t) => t.patternId && t.patternId !== 'sigh').slice(0, 4).map((t) => ({
  href: t.href,
  label: t.shortTitle,
}));

Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600, stale-while-revalidate=86400');
---

<ToolLayout
  title="Physiological Sigh Timer — Free Stress Reset"
  description="Free physiological sigh timer: double inhale, long exhale. Fast stress downshift with visual and audio cues. No signup."
  canonical="https://dailymeditationguide.com/tools/physiological-sigh"
  h1="Physiological Sigh Timer"
  lead={copy.lead}
  howToSteps={copy.howToSteps}
  faq={copy.faq}
  relatedCategoryHref="/category/anxiety"
  relatedCategoryLabel="Anxiety sessions"
  siblingLinks={siblings}
>
  <BreathPacer client:load slot="tool" initialPattern="sigh" />
  <div slot="after-tool" class="space-y-6 mt-6">
    <RelatedSessions categoryHints={['anxiety', 'breathwork']} />
    <ToolEmailCapture client:visible toolSlug="physiological-sigh" />
  </div>
  <ToolRichContent slot="content" sections={copy.sections} />
</ToolLayout>
