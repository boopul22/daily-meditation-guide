---
import ToolLayout from '../../components/tools/ToolLayout.astro';
import BreathPacer from '../../components/tools/BreathPacer';
import RelatedSessions from '../../components/tools/RelatedSessions.astro';
import ToolEmailCapture from '../../components/tools/ToolEmailCapture';
import ToolRichContent from '../../components/tools/ToolRichContent.astro';
import { TOOLS } from '../../lib/tools/catalog';
import { LANDING } from '../../lib/tools/landingCopy';

const copy = LANDING['coherent-breathing'];
const siblings = TOOLS.filter((t) => t.patternId && t.patternId !== 'coherent').slice(0, 4).map((t) => ({
  href: t.href,
  label: t.shortTitle,
}));

Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600, stale-while-revalidate=86400');
---

<ToolLayout
  title="Coherent Breathing Timer — Free Online (~6 Breaths/Min)"
  description="Free coherent breathing timer near six breaths per minute. Steady inhale and exhale for calm focus. Audio cues, no signup."
  canonical="https://dailymeditationguide.com/tools/coherent-breathing"
  h1="Coherent Breathing Timer"
  lead={copy.lead}
  howToSteps={copy.howToSteps}
  faq={copy.faq}
  relatedCategoryHref="/category/breathwork"
  relatedCategoryLabel="Breathwork sessions"
  siblingLinks={siblings}
>
  <BreathPacer client:load slot="tool" initialPattern="coherent" />
  <div slot="after-tool" class="space-y-6 mt-6">
    <RelatedSessions categoryHints={['breathwork', 'focus']} />
    <ToolEmailCapture client:visible toolSlug="coherent-breathing" />
  </div>
  <ToolRichContent slot="content" sections={copy.sections} />
</ToolLayout>
