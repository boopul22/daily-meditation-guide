---
import ToolLayout from '../../components/tools/ToolLayout.astro';
import SessionFinder from '../../components/tools/SessionFinder';
import ToolRichContent from '../../components/tools/ToolRichContent.astro';
import { SESSION_SELECT_WITH_AUTHOR, rowToSession } from '../../lib/db';
import { LANDING } from '../../lib/tools/landingCopy';

const copy = LANDING['session-finder'];
const db = Astro.locals.runtime.env.DB;
const res = await db
  .prepare(`${SESSION_SELECT_WITH_AUTHOR} WHERE s.status = 'published' ORDER BY s.published_at DESC LIMIT 80`)
  .all();
const sessions = ((res.results || []) as any[]).map(rowToSession).map((s) => ({
  slug: s.slug,
  title: s.title,
  category: s.category,
  duration: s.duration,
  durationSec: s.durationSec,
  description: s.description,
}));

Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600, stale-while-revalidate=86400');
---

<ToolLayout
  title="Meditation Session Finder — Free"
  description="Find a guided meditation by goal and time. Free matcher into the Daily Meditation Guide library. No signup."
  canonical="https://dailymeditationguide.com/tools/session-finder"
  h1="Meditation Session Finder"
  lead={copy.lead}
  howToSteps={copy.howToSteps}
  faq={copy.faq}
  siblingLinks={[
    { href: '/tools', label: 'All tools' },
    { href: '/sessions', label: 'Full library' },
  ]}
>
  <SessionFinder client:load slot="tool" sessions={sessions} />
  <ToolRichContent slot="content" sections={copy.sections} />
</ToolLayout>
