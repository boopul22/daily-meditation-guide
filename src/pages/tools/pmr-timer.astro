---
import ToolLayout from '../../components/tools/ToolLayout.astro';
import PMRTimer from '../../components/tools/PMRTimer';
import RelatedSessions from '../../components/tools/RelatedSessions.astro';
import ToolRichContent from '../../components/tools/ToolRichContent.astro';
import { LANDING } from '../../lib/tools/landingCopy';

const copy = LANDING['pmr-timer'];

Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600, stale-while-revalidate=86400');
---

<ToolLayout
  title="Progressive Muscle Relaxation Timer — Free"
  description="Free progressive muscle relaxation (PMR) timer. Tense and release through the body for sleep and stress relief. No signup."
  canonical="https://dailymeditationguide.com/tools/pmr-timer"
  h1="Progressive Muscle Relaxation Timer"
  lead={copy.lead}
  howToSteps={copy.howToSteps}
  faq={copy.faq}
  relatedCategoryHref="/category/sleep"
  relatedCategoryLabel="Sleep sessions"
  siblingLinks={[
    { href: '/tools/cognitive-shuffle', label: 'Cognitive Shuffle' },
    { href: '/tools/4-7-8-breathing-timer', label: '4-7-8 Timer' },
  ]}
>
  <PMRTimer client:load slot="tool" />
  <div slot="after-tool" class="mt-6">
    <RelatedSessions categoryHints={['sleep', 'anxiety']} />
  </div>
  <ToolRichContent slot="content" sections={copy.sections} />
</ToolLayout>
