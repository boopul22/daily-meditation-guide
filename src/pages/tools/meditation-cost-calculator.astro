---
import ToolLayout from '../../components/tools/ToolLayout.astro';
import CostCalculator from '../../components/tools/CostCalculator';
import ToolRichContent from '../../components/tools/ToolRichContent.astro';
import { LANDING } from '../../lib/tools/landingCopy';

const copy = LANDING['meditation-cost-calculator'];

Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600, stale-while-revalidate=86400');
---

<ToolLayout
  title="Meditation App Cost Calculator — Free"
  description="Estimate what Calm, Headspace, or similar apps can cost over years, then try free breathing tools and sessions here."
  canonical="https://dailymeditationguide.com/tools/meditation-cost-calculator"
  h1="Meditation App Cost Calculator"
  lead={copy.lead}
  howToSteps={copy.howToSteps}
  faq={copy.faq}
  siblingLinks={[
    { href: '/tools', label: 'Free tools' },
    { href: '/sessions', label: 'Session library' },
  ]}
>
  <CostCalculator client:load slot="tool" />
  <ToolRichContent slot="content" sections={copy.sections} />
</ToolLayout>
